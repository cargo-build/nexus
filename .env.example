# ==========
# LM SERIVCE
# ==========

# Server
LM_SERVICE_GRPC_ADDR_CUTTED=[::1]:50051
LM_SERVICE_MAX_WORKERS=4

# Model
MODEL_NAME=../../models/Qwen3.5-9B-Q4_K_M.gguf

# LLaMA.cpp params
# CPU profile (default): no GPU offload, a context size that fits system RAM.
LLAMA_N_GPU_LAYERS=0
LLAMA_N_CTX=8192
LLAMA_N_BATCH=512
LLAMA_N_UBATCH=256
# CUDA profile: build llama-cpp-python with GPU support (docs/LLAMA_CPP_CUDA.md),
# then override these:
# LLAMA_N_GPU_LAYERS=-1   # -1 offloads all layers
# LLAMA_N_CTX=32768       # up to the model's trained limit, as VRAM allows
# LLAMA_N_THREADS=4
# LLAMA_N_THREADS_BATCH=
# LLAMA_CHAT_FORMAT=

# Memory & Performance
LLAMA_OFFLOAD_KQV=false
LLAMA_FLASH_ATTN=false
LLAMA_LOW_VRAM=false

# Quantization
# LLAMA_N_PARTS=
LLAMA_USE_MMAP=true
LLAMA_USE_MLOCK=false



# ===============
# LM ORCHESTRATOR
# ===============

# Server
LM_SERVICE_GRPC_ADDR=http://[::1]:50051
LM_ORCHESTRATOR_HTTP_PORT=8080

# Data Bases
REDIS_URL=redis://localhost:6379
MONGO_URI=mongodb://localhost:27017
MONGO_DB=nexus_mind
REDIS_TTL_SECS=86400
QDRANT_URL=http://localhost:6334
QDRANT_COLLECTION_NAME=knowledge_base
QDRANT_URL=http://localhost:6334
QDRANT_COLLECTION=nexus_docs
MAX_SPARSE_SIZE=4096

# Agent settings
LM_SERVICE_REQUEST_TIMEOUT=300
QDRANT_SEARCH_LIMIT=32
PROVIDER_TYPE=grpc
AGENT_TYPE=rag
HISTORY_MAX_MESSAGES=4
SUMMARY_INTERVAL=2
EMBEDDING_MODEL_PATH=./models/minilm/model.onnx
EMBEDDING_TOKENIZER_PATH=./models/minilm/tokenizer.json

# Logging
ONNX_LOG_LEVEL="warning"
RUST_LOG=debug,ort=warn
LOG_JSON=false



# ======
# CLIENT
# ======

SERVER_URL=http://localhost:8080
HEALTH_POLL_SECS=10
DOCS_MAX_FILE_SIZE=10485760
CONVERSATIONS_FILE="${HOME}/.config/nexus/conversations.json"
